{
  "ConnectionStrings": {
    "Scheduler": "Host=localhost;Port=5432;Database=scheduler;Username=scheduler;Password=scheduler"
  },
  "Booking": {
    "SlotMinutes": 15,
    "MaxDaysAhead": 180
  },
  "Database": {
    "Initialize": true
  },
  "Seed": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
